# Copy to .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Password of the rag_app runtime role (non-superuser, subject to RLS). Letters and digits only.
APP_DB_PASSWORD=ragappdev

# API and worker connect as rag_app (RLS applies). Migrations run as the owner (rag).
DATABASE_URL=postgresql+asyncpg://rag_app:ragappdev@postgres:5432/rag
MIGRATION_DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

REDIS_URL=redis://redis:6379/0

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
# Endpoint the BROWSER can reach (it is part of the presigned URL signature)
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=documents
MINIO_WEBHOOK_TOKEN=change-this-webhook-token
MAX_UPLOAD_MB=50

# --- Auth -------------------------------------------------------------------
# Generate a strong value (see README)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# --- Embeddings and LLM (any OpenAI-compatible API) --------------------------
# Default: local Ollama (docker compose --profile local-llm up)
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=

LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# OpenAI example (migration 0002 fixes vector(1024): for text-embedding-3-small request
# dimensions=1024 or add a migration with the dimension you need)
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Observability ----------------------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=admin
LOG_LEVEL=INFO
